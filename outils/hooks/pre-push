#!/bin/sh
# Refuse une publication qui emporterait des données personnelles.
#
# Ce dépôt est public, et il a déjà porté pendant vingt mois les jetons, les
# prénoms et les photographies de quatre enfants. Ce crochet est le garde-fou
# qui manquait : il s'exécute avant que quoi que ce soit ne parte vers GitHub.
#
# Installation (une fois, vaut pour tous les worktrees) :
#     git config core.hooksPath outils/hooks
#
# Git transmet sur l'entrée standard une ligne par référence poussée :
#     <réf locale> <sha local> <réf distante> <sha distant>
# Le sha distant vaut zéro quand la branche n'existe pas encore en face.

# fuite-acceptee : le SHA nul de git, que Git transmet pour une branche neuve.
ZERO="0000000000000000000000000000000000000000"

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "pre-push : Python est introuvable, contrôle impossible." >&2
    echo "           Publication refusée par précaution." >&2
    exit 1
fi

RACINE=$(git rev-parse --show-toplevel)
CONTROLE="$RACINE/outils/verifier_fuites.py"

if [ ! -f "$CONTROLE" ]; then
    echo "pre-push : $CONTROLE est absent, contrôle impossible." >&2
    exit 1
fi

CODE=0

while read -r _ sha_local _ sha_distant; do
    # Suppression d'une branche distante : rien n'est publié.
    [ "$sha_local" = "$ZERO" ] && continue

    if [ "$sha_distant" = "$ZERO" ]; then
        # Branche neuve : pas de point de comparaison en face, on relit tout
        # le contenu suivi plutôt que de deviner une base.
        "$PYTHON" "$CONTROLE" --arbre --racine "$RACINE" || CODE=1
    else
        "$PYTHON" "$CONTROLE" --plage "$sha_distant..$sha_local" --racine "$RACINE" || CODE=1
    fi
done

if [ "$CODE" -ne 0 ]; then
    echo "" >&2
    echo "Publication interrompue. Pour outrepasser en connaissance de cause :" >&2
    echo "    git push --no-verify" >&2
fi

exit "$CODE"
